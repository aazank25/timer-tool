{
  "name": "focusdesk",
  "private": true,
  "version": "0.1.2",
  "description": "FocusDesk as a menu-bar app",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "payload": "node scripts/build.mjs",
    "start": "npm run payload && electron .",
    "dist:mac": "npm run payload && node scripts/dist-mac.mjs",
    "dist:mac:all": "npm run payload && node scripts/dist-mac.mjs --all",
    "dist:win": "npm run payload && electron-builder --win",
    "dist:linux": "npm run payload && electron-builder --linux",
    "pack": "npm run payload && electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "com.focusdesk.app",
    "productName": "FocusDesk",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "palette.mjs",
      "away.mjs",
      "close-window.mjs",
      "attention.mjs",
      "menu-bar.mjs",
      "privacy.mjs",
      "requests.mjs",
      "shortcuts.mjs",
      "window-route.mjs",
      "preload.cjs",
      "dist/**/*",
      "web/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/build/**"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "afterPack": "./scripts/after-pack.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "notarize": false
    },
    "dmg": {
      "title": "FocusDesk",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "focusdesk"
    },
    "npmRebuild": false,
    "publish": null
  },
  "author": "FocusDesk",
  "repository": "https://github.com/aazank25/timer-tool"
}
