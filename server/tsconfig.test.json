{
  // The build config only reaches src/. This one adds the tests so a type error
  // in them fails `npm run typecheck`; it never emits.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The tests live beside src, not inside it.
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
